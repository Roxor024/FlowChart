{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "FlowPilot integration blueprint 0.3.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "project",
    "status",
    "reviewStatus",
    "requirements",
    "components",
    "decisions",
    "implementationTasks",
    "testCases",
    "risks",
    "openQuestions",
    "conflicts",
    "operations"
  ],
  "properties": {
    "schemaVersion": {
      "const": "0.3.0"
    },
    "project": {
      "type": "string",
      "pattern": "\\S"
    },
    "status": {
      "enum": [
        "draft",
        "provisional",
        "approved"
      ]
    },
    "reviewStatus": {
      "enum": [
        "unreviewed",
        "in_review",
        "approved"
      ]
    },
    "reviewEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "reviewer",
        "reviewedAt",
        "evidenceRef"
      ],
      "properties": {
        "reviewer": {
          "type": "string",
          "pattern": "\\S"
        },
        "reviewedAt": {
          "type": "string",
          "format": "date-time"
        },
        "evidenceRef": {
          "type": "string",
          "pattern": "\\S"
        }
      }
    },
    "summary": {
      "type": "string"
    },
    "dataClassification": {
      "enum": [
        "unknown",
        "public",
        "internal",
        "confidential",
        "restricted"
      ]
    },
    "requirements": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "title",
          "status"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^REQ-[0-9]{3,}$"
          },
          "title": {
            "type": "string",
            "pattern": "\\S"
          },
          "status": {
            "enum": [
              "confirmed",
              "assumed",
              "unknown",
              "conflicting"
            ]
          },
          "type": {
            "enum": [
              "functional",
              "nonfunctional"
            ]
          },
          "priority": {
            "enum": [
              "critical",
              "high",
              "medium",
              "low"
            ]
          },
          "acceptanceCriteria": {
            "type": "string"
          },
          "source": {
            "type": "string"
          }
        }
      }
    },
    "components": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "title",
          "requirementIds"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^CMP-[0-9]{3,}$"
          },
          "title": {
            "type": "string",
            "pattern": "\\S"
          },
          "requirementIds": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^REQ-[0-9]{3,}$"
            },
            "uniqueItems": true,
            "minItems": 1
          },
          "description": {
            "type": "string"
          },
          "azureService": {
            "type": "string"
          },
          "sku": {
            "type": "string"
          },
          "responsibility": {
            "type": "string"
          }
        }
      }
    },
    "decisions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "title",
          "requirementIds"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^ADR-[0-9]{3,}$"
          },
          "title": {
            "type": "string",
            "pattern": "\\S"
          },
          "requirementIds": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^REQ-[0-9]{3,}$"
            },
            "uniqueItems": true,
            "minItems": 1
          },
          "description": {
            "type": "string"
          },
          "rationale": {
            "type": "string"
          },
          "alternative": {
            "type": "string"
          },
          "tradeoff": {
            "type": "string"
          },
          "status": {
            "enum": [
              "proposed",
              "accepted",
              "rejected"
            ]
          }
        }
      }
    },
    "implementationTasks": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "title",
          "requirementIds"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^IMP-[0-9]{3,}$"
          },
          "title": {
            "type": "string",
            "pattern": "\\S"
          },
          "requirementIds": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^REQ-[0-9]{3,}$"
            },
            "uniqueItems": true,
            "minItems": 1
          },
          "description": {
            "type": "string"
          },
          "dependsOn": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^IMP-[0-9]{3,}$"
            }
          },
          "verification": {
            "type": "string"
          },
          "rollback": {
            "type": "string"
          },
          "componentIds": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^CMP-[0-9]{3,}$"
            }
          }
        }
      }
    },
    "testCases": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "title",
          "requirementIds",
          "status"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^TST-[0-9]{3,}$"
          },
          "title": {
            "type": "string",
            "pattern": "\\S"
          },
          "requirementIds": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^REQ-[0-9]{3,}$"
            },
            "uniqueItems": true,
            "minItems": 1
          },
          "description": {
            "type": "string"
          },
          "status": {
            "enum": [
              "not_run",
              "blocked",
              "passed",
              "failed"
            ]
          },
          "expectedResult": {
            "type": "string"
          },
          "evidenceRef": {
            "type": "string"
          },
          "executedAt": {
            "type": "string",
            "format": "date-time"
          },
          "environment": {
            "type": "string"
          },
          "artifactHash": {
            "type": "string"
          }
        }
      }
    },
    "risks": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "title",
          "requirementIds"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^RSK-[0-9]{3,}$"
          },
          "title": {
            "type": "string",
            "pattern": "\\S"
          },
          "requirementIds": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^REQ-[0-9]{3,}$"
            },
            "uniqueItems": true,
            "minItems": 1
          },
          "description": {
            "type": "string"
          },
          "severity": {
            "enum": [
              "critical",
              "high",
              "medium",
              "low"
            ]
          },
          "owner": {
            "type": "string"
          },
          "mitigation": {
            "type": "string"
          },
          "evidence": {
            "type": "string"
          }
        }
      }
    },
    "openQuestions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "title",
          "blocking"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^QUE-[0-9]{3,}$"
          },
          "title": {
            "type": "string",
            "pattern": "\\S"
          },
          "blocking": {
            "type": "boolean"
          },
          "requirementIds": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^REQ-[0-9]{3,}$"
            },
            "uniqueItems": true
          },
          "owner": {
            "type": "string"
          }
        }
      }
    },
    "conflicts": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "title",
          "status",
          "requirementIds"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^CON-[0-9]{3,}$"
          },
          "title": {
            "type": "string",
            "pattern": "\\S"
          },
          "status": {
            "enum": [
              "open",
              "resolved"
            ]
          },
          "resolution": {
            "type": "string"
          },
          "requirementIds": {
            "type": "array",
            "minItems": 2,
            "items": {
              "type": "string",
              "pattern": "^REQ-[0-9]{3,}$"
            },
            "uniqueItems": true
          }
        }
      }
    },
    "operations": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "monitoring": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "alerts": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "recovery": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "owners": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "const": "approved"
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "properties": {
          "reviewStatus": {
            "const": "approved"
          }
        },
        "required": [
          "reviewEvidence"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "reviewStatus": {
            "const": "approved"
          }
        },
        "required": [
          "reviewStatus"
        ]
      },
      "then": {
        "properties": {
          "status": {
            "const": "approved"
          }
        },
        "required": [
          "reviewEvidence"
        ]
      }
    }
  ]
}
