{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Roxor024/FlowChart/schemas/integration-blueprint-0.4.0.json",
  "title": "FlowPilot integration blueprint 0.4.0",
  "description": "Machine-readable engineering blueprint produced by the FlowPilot Architect skill. Structural rules live here; cross-reference and approval rules live in scripts/validate_blueprint.py.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "project",
    "status",
    "reviewStatus",
    "requirements",
    "components",
    "decisions",
    "implementationTasks",
    "testCases",
    "risks",
    "openQuestions",
    "conflicts",
    "operations"
  ],
  "properties": {
    "schemaVersion": {
      "const": "0.4.0"
    },
    "project": {
      "type": "string",
      "pattern": "\\S"
    },
    "status": {
      "enum": [
        "provisional",
        "draft",
        "approved"
      ],
      "description": "provisional = requirements insufficient for a full design; draft = complete proposal awaiting review; approved = human approval evidenced"
    },
    "reviewStatus": {
      "enum": [
        "unreviewed",
        "in_review",
        "approved"
      ]
    },
    "reviewEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "reviewer",
        "reviewedAt",
        "evidenceRef"
      ],
      "properties": {
        "reviewer": {
          "type": "string",
          "pattern": "\\S"
        },
        "reviewedAt": {
          "type": "string",
          "format": "date-time"
        },
        "evidenceRef": {
          "type": "string",
          "pattern": "\\S",
          "description": "Reference to an external record (PR, change ticket, CAB minute) — not a free-text claim"
        }
      }
    },
    "summary": {
      "type": "string"
    },
    "dataClassification": {
      "enum": [
        "unknown",
        "public",
        "internal",
        "confidential",
        "restricted"
      ]
    },
    "requirements": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "title",
          "status"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^REQ-[0-9]{3,}$"
          },
          "title": {
            "type": "string",
            "pattern": "\\S"
          },
          "status": {
            "enum": [
              "confirmed",
              "assumed",
              "unknown",
              "conflicting"
            ]
          },
          "type": {
            "enum": [
              "functional",
              "nonfunctional"
            ]
          },
          "priority": {
            "enum": [
              "critical",
              "high",
              "medium",
              "low"
            ]
          },
          "acceptanceCriteria": {
            "type": "string"
          },
          "source": {
            "type": "string"
          }
        }
      }
    },
    "components": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "title",
          "requirementIds"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^CMP-[0-9]{3,}$"
          },
          "title": {
            "type": "string",
            "pattern": "\\S"
          },
          "requirementIds": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^REQ-[0-9]{3,}$"
            },
            "uniqueItems": true,
            "minItems": 1
          },
          "description": {
            "type": "string"
          },
          "azureService": {
            "type": "string"
          },
          "sku": {
            "type": "string"
          },
          "responsibility": {
            "type": "string"
          }
        }
      }
    },
    "decisions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "title",
          "requirementIds"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^ADR-[0-9]{3,}$"
          },
          "title": {
            "type": "string",
            "pattern": "\\S"
          },
          "requirementIds": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^REQ-[0-9]{3,}$"
            },
            "uniqueItems": true,
            "minItems": 1
          },
          "description": {
            "type": "string"
          },
          "rationale": {
            "type": "string"
          },
          "alternative": {
            "type": "string"
          },
          "tradeoff": {
            "type": "string"
          },
          "status": {
            "enum": [
              "proposed",
              "accepted",
              "rejected",
              "superseded"
            ]
          }
        }
      }
    },
    "implementationTasks": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "title",
          "requirementIds"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^IMP-[0-9]{3,}$"
          },
          "title": {
            "type": "string",
            "pattern": "\\S"
          },
          "requirementIds": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^REQ-[0-9]{3,}$"
            },
            "uniqueItems": true,
            "minItems": 1
          },
          "description": {
            "type": "string"
          },
          "dependsOn": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^IMP-[0-9]{3,}$"
            },
            "uniqueItems": true
          },
          "componentIds": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^CMP-[0-9]{3,}$"
            },
            "uniqueItems": true
          },
          "prerequisites": {
            "type": "string"
          },
          "verification": {
            "type": "string"
          },
          "rollback": {
            "type": "string"
          }
        }
      }
    },
    "testCases": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "title",
          "requirementIds",
          "status"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^TST-[0-9]{3,}$"
          },
          "title": {
            "type": "string",
            "pattern": "\\S"
          },
          "requirementIds": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^REQ-[0-9]{3,}$"
            },
            "uniqueItems": true,
            "minItems": 1
          },
          "description": {
            "type": "string"
          },
          "type": {
            "enum": [
              "functional",
              "failure",
              "security",
              "performance",
              "operational"
            ]
          },
          "status": {
            "enum": [
              "not_run",
              "blocked",
              "passed",
              "failed"
            ]
          },
          "expectedResult": {
            "type": "string"
          },
          "evidenceRef": {
            "type": "string"
          },
          "executedAt": {
            "type": "string",
            "format": "date-time"
          },
          "environment": {
            "type": "string"
          },
          "artifactHash": {
            "type": "string",
            "pattern": "^[0-9a-fA-F]{64}$"
          }
        }
      }
    },
    "risks": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "title",
          "requirementIds"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^RSK-[0-9]{3,}$"
          },
          "title": {
            "type": "string",
            "pattern": "\\S"
          },
          "requirementIds": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^REQ-[0-9]{3,}$"
            },
            "uniqueItems": true,
            "minItems": 1
          },
          "description": {
            "type": "string"
          },
          "severity": {
            "enum": [
              "critical",
              "high",
              "medium",
              "low"
            ]
          },
          "owner": {
            "type": "string"
          },
          "mitigation": {
            "type": "string"
          },
          "evidence": {
            "type": "string"
          }
        }
      }
    },
    "openQuestions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "title",
          "blocking"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^QUE-[0-9]{3,}$"
          },
          "title": {
            "type": "string",
            "pattern": "\\S"
          },
          "blocking": {
            "type": "boolean"
          },
          "requirementIds": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^REQ-[0-9]{3,}$"
            },
            "uniqueItems": true
          },
          "owner": {
            "type": "string"
          }
        }
      }
    },
    "conflicts": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "title",
          "status",
          "requirementIds"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^CON-[0-9]{3,}$"
          },
          "title": {
            "type": "string",
            "pattern": "\\S"
          },
          "status": {
            "enum": [
              "open",
              "resolved"
            ]
          },
          "explanation": {
            "type": "string"
          },
          "options": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "\\S"
            }
          },
          "resolution": {
            "type": "string"
          },
          "requirementIds": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^REQ-[0-9]{3,}$"
            },
            "uniqueItems": true,
            "minItems": 2
          }
        }
      }
    },
    "operations": {
      "type": "object",
      "additionalProperties": false,
      "required": [],
      "properties": {
        "monitoring": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "\\S"
          }
        },
        "alerts": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "\\S"
          }
        },
        "tracing": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "\\S"
          }
        },
        "recovery": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "\\S"
          }
        },
        "maintenance": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "\\S"
          }
        },
        "owners": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "\\S"
          }
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "const": "approved"
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "properties": {
          "reviewStatus": {
            "const": "approved"
          }
        },
        "required": [
          "reviewEvidence"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "reviewStatus": {
            "const": "approved"
          }
        },
        "required": [
          "reviewStatus"
        ]
      },
      "then": {
        "properties": {
          "status": {
            "const": "approved"
          }
        },
        "required": [
          "reviewEvidence"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "conflicts": {
            "contains": {
              "properties": {
                "status": {
                  "const": "resolved"
                }
              },
              "required": [
                "status"
              ]
            }
          }
        }
      },
      "then": {
        "properties": {
          "conflicts": {
            "items": {
              "if": {
                "properties": {
                  "status": {
                    "const": "resolved"
                  }
                }
              },
              "then": {
                "required": [
                  "resolution"
                ]
              }
            }
          }
        }
      }
    }
  ]
}
