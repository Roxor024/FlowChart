{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "FlowPilot v0.2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "project",
    "status",
    "reviewStatus",
    "requirements",
    "components",
    "decisions",
    "implementationTasks",
    "testCases",
    "risks",
    "openQuestions",
    "conflicts"
  ],
  "properties": {
    "schemaVersion": {
      "const": "0.2.0"
    },
    "project": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "enum": [
        "draft",
        "approved"
      ]
    },
    "reviewStatus": {
      "enum": [
        "unreviewed",
        "approved"
      ]
    },
    "reviewEvidence": {
      "type": "object",
      "required": [
        "reviewer",
        "reviewedAt",
        "evidence"
      ]
    },
    "requirements": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "title",
          "status"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^REQ-[0-9]{3,}$"
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "enum": [
              "confirmed",
              "assumed",
              "unknown"
            ]
          },
          "acceptanceCriteria": {
            "type": "string"
          }
        }
      }
    },
    "components": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "title",
          "requirementIds"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Z]+-[0-9]{3,}$"
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "requirementIds": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "pattern": "^REQ-[0-9]{3,}$"
            }
          }
        }
      }
    },
    "decisions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "title",
          "requirementIds"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Z]+-[0-9]{3,}$"
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "requirementIds": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "pattern": "^REQ-[0-9]{3,}$"
            }
          }
        }
      }
    },
    "implementationTasks": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "title",
          "requirementIds"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Z]+-[0-9]{3,}$"
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "requirementIds": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "pattern": "^REQ-[0-9]{3,}$"
            }
          }
        }
      }
    },
    "testCases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "title",
          "requirementIds"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Z]+-[0-9]{3,}$"
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "requirementIds": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "pattern": "^REQ-[0-9]{3,}$"
            }
          },
          "status": {
            "enum": [
              "not_run",
              "blocked",
              "passed",
              "failed"
            ]
          },
          "evidence": {
            "type": "string"
          },
          "executedAt": {
            "type": "string"
          },
          "environment": {
            "type": "string"
          }
        }
      }
    },
    "risks": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "title",
          "requirementIds"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Z]+-[0-9]{3,}$"
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "requirementIds": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "pattern": "^REQ-[0-9]{3,}$"
            }
          }
        }
      }
    },
    "openQuestions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "title",
          "blocking"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^QUE-[0-9]{3,}$"
          },
          "title": {
            "type": "string"
          },
          "blocking": {
            "type": "boolean"
          }
        }
      }
    },
    "conflicts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "title",
          "requirementIds"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Z]+-[0-9]{3,}$"
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "requirementIds": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "pattern": "^REQ-[0-9]{3,}$"
            }
          }
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "const": "approved"
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "properties": {
          "reviewStatus": {
            "const": "approved"
          }
        },
        "required": [
          "reviewEvidence"
        ]
      }
    }
  ]
}